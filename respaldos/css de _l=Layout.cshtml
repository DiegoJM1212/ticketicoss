/* layout.css
   Estilos para el layout principal (_Layout.cshtml)
*/

/* Reset y estilos básicos */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background-color: #000;
    color: #fff;
    font-family: Arial, sans-serif;
}

/* =========================================
   Barra de navegación (sticky, fondo con transparencia y letra grande)
   ========================================= */
header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 999; /* Asegura que quede sobre todo el contenido */
    /* Usamos un fondo negro con 40% de transparencia */
    background-color: rgba(0, 0, 0, 0.6);
    padding: 10px 20px;
}

/* Estructura interna de la barra: parte izquierda y buscador a la derecha */
.navbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

/* Contenedor izquierdo: logo y menú */
.navbar-left {
    display: flex;
    align-items: center;
    gap: 20px;
}

/* Logo: mayor tamaño */
.logo img {
    height: 60px; /* Logo más grande */
}

/* Menú principal */
.menu {
    list-style: none;
    display: flex;
    gap: 15px;
}

    .menu li {
        position: relative; /* Necesario para el dropdown */
    }

        /* Enlaces de menú con letras grandes y transición */
        .menu li a {
            color: #9efc00;
            text-decoration: none;
            font-weight: bold;
            padding: 5px;
            font-size: 1.3rem;
            transition: color 0.3s ease;
        }

            .menu li a:hover {
                color: #fff;
            }

/* Dropdown de categorías */
.dropdown-content {
    display: none;
    position: absolute;
    top: 30px;
    left: 0;
    background-color: #222;
    padding: 10px;
    border-radius: 4px;
    min-width: 120px;
}

    .dropdown-content a {
        display: block;
        margin: 5px 0;
        color: #9efc00;
        text-decoration: none;
        transition: color 0.3s ease;
    }

        .dropdown-content a:hover {
            color: #fff;
        }

.menu li:hover .dropdown-content {
    display: block;
}

/* =========================================
   Contenedor de búsqueda
   ========================================= */
.search-container {
    display: flex;
    align-items: center;
    gap: 5px;
}

    .search-container input {
        padding: 5px 10px;
        font-size: 1rem;
        border: none;
        border-radius: 4px;
    }

    .search-container button {
        padding: 6px 12px;
        font-size: 1rem;
        background-color: #9efc00;
        color: #000;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

        .search-container button:hover {
            background-color: #fff;
        }

/* =========================================
   Para que el contenido no quede debajo del header fijo
   ========================================= */
.banner, .artistas-destacados, .eventos-section {
    margin-top: 80px; /* Ajusta según la altura real de tu header */
}

/* Área principal */
main {
    min-height: 70vh;
}

/* Footer */
footer {
    background-color: #111;
    text-align: center;
    margin-top: 20px;
    padding: 10px;
}

/*Este es para el icono de usuario*/

.profile-icon {
    font-family: "Segoe MDL2 Assets", sans-serif;
    font-size: 1.5rem; /* Ajusta el tamaño según necesites */
    margin-right: 5px;
    vertical-align: middle;
}

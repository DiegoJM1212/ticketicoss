@page
@model WebApplication1.Pages.Cliente.RegistroModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Crear Cuenta";
}

<div class="fullscreen-container">
    <div class="registro-container">
        <div class="registro-form">
            <div class="header-neon">
                Crear Cuenta
            </div>

            <div class="form-content">
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger">@Model.ErrorMessage</div>
                }

                @if (Model.RegistroExitoso)
                {
                    <div class="alert alert-success">
                        Registro exitoso. <a href="/Cliente/Login" class="alert-link">Iniciar sesión</a>
                    </div>
                }
                else
                {
                    <form method="post">
                        <div class="form-group">
                            <label asp-for="Usuario.Nombre">Nombre</label>
                            <div class="input-with-icon">
                                <input type="text" class="form-control" asp-for="Usuario.Nombre" required>
                                <span class="input-icon">
                                    <i class="bi bi-person-fill"></i>
                                </span>
                            </div>
                            <span asp-validation-for="Usuario.Nombre" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Usuario.Apellidos">Apellidos</label>
                            <div class="input-with-icon">
                                <input type="text" class="form-control" asp-for="Usuario.Apellidos" required>
                                <span class="input-icon">
                                    <i class="bi bi-person-fill"></i>
                                </span>
                            </div>
                            <span asp-validation-for="Usuario.Apellidos" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Usuario.Correo">Correo electrónico</label>
                            <div class="input-with-icon">
                                <input type="email" class="form-control" asp-for="Usuario.Correo" required>
                                <span class="input-icon">
                                    <i class="bi bi-envelope-fill"></i>
                                </span>
                            </div>
                            <span asp-validation-for="Usuario.Correo" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Usuario.Contrasena">Contraseña</label>
                            <div class="input-with-icon">
                                <input type="password" class="form-control" asp-for="Usuario.Contrasena" id="password" required>
                                <span class="input-icon" onclick="togglePassword('password')">
                                    <i class="bi bi-eye-fill"></i>
                                </span>
                            </div>
                            <span asp-validation-for="Usuario.Contrasena" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="ConfirmarContrasena">Confirmar contraseña</label>
                            <div class="input-with-icon">
                                <input type="password" class="form-control" asp-for="ConfirmarContrasena" id="confirmPassword" required>
                                <span class="input-icon" onclick="togglePassword('confirmPassword')">
                                    <i class="bi bi-eye-fill"></i>
                                </span>
                            </div>
                            <span asp-validation-for="ConfirmarContrasena" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Usuario.Identificacion">Identificación</label>
                            <div class="input-with-icon">
                                <input type="text" class="form-control" asp-for="Usuario.Identificacion" required>
                                <span class="input-icon">
                                    <i class="bi bi-card-text"></i>
                                </span>
                            </div>
                            <span asp-validation-for="Usuario.Identificacion" class="text-danger"></span>
                        </div>

                        <div class="form-buttons">
                            <button type="submit" class="btn-registrarse">Registrarse</button>
                            <button type="button" class="btn-regresar" onclick="window.location.href='/Cliente/login'">Regresar</button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .fullscreen-container {
        background-color: #000;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .registro-container {
        width: 100%;
        max-width: 400px;
    }

    .registro-form {
        background-color: transparent;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.5);
    }

    .header-neon {
        background-color: #BFF747;
        color: #000;
        text-align: center;
        padding: 15px;
        font-size: 20px;
        font-weight: bold;
    }

    .form-content {
        background-color: #888;
        padding: 20px;
    }

    .form-group {
        margin-bottom: 15px;
    }

        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
            color: #000;
        }

    .input-with-icon {
        position: relative;
    }

        .input-with-icon .form-control {
            padding-right: 40px;
            background-color: #888;
            border: none;
            border-bottom: 1px solid #555;
            border-radius: 0;
            color: #000;
            height: 40px;
        }

            .input-with-icon .form-control:focus {
                outline: none;
                box-shadow: none;
                border-bottom: 2px solid #BFF747;
            }

    .input-icon {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        color: #000;
        cursor: pointer;
    }

    .form-buttons {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 20px;
    }

    .btn-registrarse {
        background-color: #BFF747;
        color: #000;
        border: none;
        padding: 10px;
        border-radius: 5px;
        font-weight: bold;
        cursor: pointer;
        transition: background-color 0.3s;
    }

        .btn-registrarse:hover {
            background-color: #a8e32c;
        }

    .btn-regresar {
        background-color: #555;
        color: #fff;
        border: none;
        padding: 10px;
        border-radius: 5px;
        cursor: pointer;
        transition: background-color 0.3s;
    }

        .btn-regresar:hover {
            background-color: #444;
        }

    .text-danger {
        color: #ff6b6b;
        font-size: 12px;
        margin-top: 5px;
        display: block;
    }

    .alert {
        padding: 10px;
        margin-bottom: 15px;
        border-radius: 5px;
    }

    .alert-danger {
        background-color: #ff6b6b;
        color: #fff;
    }

    .alert-success {
        background-color: #4CAF50;
        color: #fff;
    }

    .alert-link {
        color: #fff;
        font-weight: bold;
        text-decoration: underline;
    }
</style>

<script>
    function togglePassword(id) {
        var x = document.getElementById(id);
        var icon = x.nextElementSibling.querySelector('i');

        if (x.type === "password") {
            x.type = "text";
            icon.classList.remove("bi-eye-fill");
            icon.classList.add("bi-eye-slash-fill");
        } else {
            x.type = "password";
            icon.classList.remove("bi-eye-slash-fill");
            icon.classList.add("bi-eye-fill");
        }
    }
</script>


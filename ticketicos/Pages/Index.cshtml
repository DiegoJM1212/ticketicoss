@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";

    bool isConcierto = Request.Query["categoria"] == "Concierto";
    bool isTeatro = Request.Query["categoria"] == "Teatro";
    bool isDeporte = Request.Query["categoria"] == "Deporte";
    bool isCultura = Request.Query["categoria"] == "Cultura";
    bool isFamilia = Request.Query["categoria"] == "Familia";

    var nombreEvento = Request.Query["nombreEvento"];
}

<!-- Agregar token antifalsificación -->
@Html.AntiForgeryToken()


<!-- Resultados de búsqueda -->
@if (!string.IsNullOrEmpty(Request.Query["categoria"]) || !string.IsNullOrEmpty(nombreEvento))
{
    <section class="eventos-section">
        <h2>
            @if (!string.IsNullOrEmpty(Request.Query["categoria"]))
            {
                <text>Eventos de @Request.Query["categoria"]</text>
            }
            else if (!string.IsNullOrEmpty(nombreEvento))
            {
                <text>Resultados para "@nombreEvento"</text>
            }
        </h2>

        <div class="eventos-grid">
            @if (Model.Eventos != null && Model.Eventos.Any())
            {
                foreach (var evento in Model.Eventos)
                {
                    <div class="evento-card">
                        <img src="@evento.Imagen" alt="@evento.Nombre" />
                        <h3>@evento.Nombre</h3>
                        <p>Fecha: @evento.Fecha.ToString("dd MMM yyyy")</p>
                        <a asp-page="/VerEvento" asp-route-id="@evento.Id" class="btn-agregar">Ver evento</a>
                    </div>
                }
            }
            else
            {
                <p>No se encontraron eventos que coincidan con los criterios de búsqueda.</p>
            }
        </div>
    </section>
}


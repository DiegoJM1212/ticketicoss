@page
@model ticketicos.Pages.Admin.ConfiguracionesModel
@{
    ViewData["Title"] = "Tickicos - Configuraciones del Sistema";
    Layout = null; // Usa el layout compartido
}

<div class="container bg-black min-vh-100 py-5">
    <!-- Logo -->
    <div class="d-flex justify-content-center mb-4">
        <div class="bg-neon d-flex align-items-center justify-content-center rounded" style="width: 80px; height: 80px;">
            <span class="fw-bold text-black">TICKICOS</span>
        </div>
    </div>
    <a href="/administrativo/Dashboard" class="dashboard-link">
        <i class="bi bi-house-door me-2"></i> Dashboard
    </a>
    <!-- Panel Principal -->
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 mx-auto">
            <div class="bg-panel rounded-4 shadow-lg overflow-hidden mb-4">
                <!-- Título -->
                <div class="bg-neon p-3 text-center">
                    <h4 class="fw-bold text-black mb-0">Configuraciones del Sistema</h4>
                </div>

                <div class="p-4">
                    <!-- Mensaje de Error o Éxito -->
                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger mb-4 rounded">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                    {
                        <div class="alert alert-success mb-4 rounded">
                            <i class="bi bi-check-circle-fill me-2"></i>@Model.SuccessMessage
                        </div>
                    }

                    <!-- Configuraciones -->
                    <div class="card bg-dark text-white border-0 rounded-4 overflow-hidden">
                        <div class="card-header bg-dark border-secondary">
                            <h5 class="mb-0">Parámetros del Sistema</h5>
                        </div>
                        <div class="card-body">
                            <table class="table table-dark table-bordered">
                                <thead>
                                    <tr>
                                        <th>Clave</th>
                                        <th>Valor</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var config in Model.Configuraciones)
                                    {
                                        <tr>
                                            <td>@config.Clave</td>
                                            <td>@config.Valor</td>
                                            <td>
                                                <button class="btn btn-warning text-dark rounded px-3 py-1 me-2" onclick="editarConfig(@config.Id, '@config.Clave', '@config.Valor')">
                                                    <i class="bi bi-pencil me-1"></i>Editar
                                                </button>
                                                @if (config.Clave.StartsWith("Custom"))
                                                {
                                                    <form method="post" asp-page-handler="EliminarConfig" class="d-inline">
                                                        <input type="hidden" name="IdConfig" value="@config.Id" />
                                                        <button type="submit" class="btn btn-danger rounded px-3 py-1">
                                                            <i class="bi bi-trash me-1"></i>Eliminar
                                                        </button>
                                                    </form>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                            <!-- Formulario para Crear Nueva Configuración -->
                            <form method="post" asp-page-handler="CrearConfig" class="mt-4">
                                <div class="row mb-3">
                                    <div class="col-md-6 mb-3 mb-md-0">
                                        <label class="form-label text-white">Clave (Custom_*)</label>
                                        <input type="text" name="Clave" class="form-control bg-dark text-white border-secondary rounded form-control-lg" placeholder="Custom_NuevaConfig" required />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label text-white">Valor</label>
                                        <textarea name="Valor" class="form-control bg-dark text-white border-secondary rounded form-control-lg" rows="3" required></textarea>
                                    </div>
                                </div>
                                <div class="d-flex justify-content-end">
                                    <button type="submit" class="btn btn-success rounded px-4 py-2">
                                        <i class="bi bi-plus-circle me-2"></i>Agregar Configuración
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Fondo negro para la página */
    .bg-black {
        background-color: #000000 !important;
    }

    /* Verde neon para elementos destacados */
    .bg-neon {
        background-color: #C1FF00 !important;
        color: #000 !important;
    }

    /* Fondo del panel */
    .bg-panel {
        background-color: #1a1a1a !important;
    }

    /* Estilo de la tarjeta y la tabla */
    .card {
        background-color: #2c2c2c !important;
        border: none !important;
        border-radius: 10px !important;
    }

    .table-dark {
        background-color: #2c2c2c !important;
    }

        .table-dark th, .table-dark td {
            border-color: #444 !important;
            color: #fff !important;
        }

    /* Botones */
    .btn {
        border-radius: 5px !important;
        padding: 0.5rem 1rem !important;
        font-weight: 500 !important;
    }

    .btn-warning {
        background-color: #FFC107 !important;
        color: #000 !important;
        border: none !important;
    }

    .btn-danger {
        background-color: #DC3545 !important;
        border: none !important;
    }

    .btn-success {
        background-color: #28A745 !important;
        border: none !important;
    }

    .btn-home {
        position: absolute;
        right: 1rem;
        top: 50%;
        transform: translateY(-50%);
        background-color: #666666;
        color: #ffffff;
        padding: 0.25rem 0.75rem;
        text-decoration: none;
        font-size: 0.875rem;
        border-radius: 0.25rem;
    }

    /* Inputs y etiquetas */
    .form-control {
        background-color: #1a1a1a !important;
        border: 1px solid #444 !important;
        color: #fff !important;
        border-radius: 5px !important;
    }

    .form-control-lg {
        padding: 0.75rem 1rem !important; /* Más padding para agrandar */
        font-size: 1.1rem !important; /* Texto un poco más grande */
    }

    .form-label {
        color: #fff !important;
    }

    /* Ajustes generales */
    .card-header {
        background-color: #2c2c2c !important;
        border-bottom: 1px solid #444 !important;
    }

    /* Centrado reforzado */
    .container {
        max-width: 100% !important;
        padding-left: 15px !important;
        padding-right: 15px !important;
    }

    .row.justify-content-center {
        display: flex !important;
        justify-content: center !important;
    }

    .col-12.col-md-10.col-lg-8 {
        margin-left: auto !important;
        margin-right: auto !important;
    }
</style>

<script>
    function editarConfig(id, clave, valor) {
        document.querySelector('input[name="Clave"]').value = clave;
        document.querySelector('textarea[name="Valor"]').value = valor; // Cambiado a textarea
        document.querySelector('form[asp-page-handler="CrearConfig"]').setAttribute('asp-page-handler', 'ActualizarConfig');
        document.querySelector('form[asp-page-handler="ActualizarConfig"]').innerHTML += `<input type="hidden" name="IdConfig" value="${id}" />`;
    }
</script>
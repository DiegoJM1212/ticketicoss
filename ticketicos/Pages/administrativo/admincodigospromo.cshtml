@page
@model ticketicos.Pages.Administrativo.AdminCodigosPromoModel
@{
    ViewData["Title"] = "Administración de Códigos Promocionales";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TICKETICOS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        .bg-black {
            background-color: #000000 !important;
        }

        .bg-neon {
            background-color: #C1FF00 !important;
        }

        .text-neon {
            color: #C1FF00 !important;
        }

        .card {
            background-color: #2c2c2c !important;
            border: none !important;
            border-radius: 10px !important;
            transition: transform 0.2s;
        }

            .card:hover {
                transform: translateY(-5px);
            }

        .card-body {
            padding: 1.5rem !important;
        }

            .card-body p {
                margin-bottom: 0.75rem !important;
                font-size: 0.9rem;
            }

        .card-title {
            font-size: 1.25rem;
            font-weight: bold;
        }

        .btn {
            border-radius: 5px !important;
            padding: 0.5rem 1rem !important;
        }

        .input-group .form-control {
            background-color: #1a1a1a !important;
            border: 1px solid #444 !important;
            color: #fff !important;
        }

        .input-group .btn {
            border: 1px solid #444 !important;
        }

        .modal-content {
            border-radius: 10px !important;
        }

        .card-text {
            color: #ffffff !important;
        }

        .btn-dashboard {
            background-color: #666666;
            color: #ffffff;
            padding: 0.5rem 1rem;
            text-decoration: none;
            font-size: 0.875rem;
            border-radius: 5px;
        }

        .modal-body {
            padding: 1.5rem !important;
        }
    </style>
</head>
<body>
    <div class="container-fluid bg-black min-vh-100 py-5">
        <!-- Logo -->
        <div class="d-flex justify-content-center mb-4">
            <div class="bg-neon d-flex align-items-center justify-content-center rounded" style="width: 80px; height: 80px;">
                <span class="fw-bold text-black">TICKICOS</span>
            </div>
        </div>

        <!-- Panel Principal -->
        <div class="container">
            <!-- Título Principal -->
            <div class="bg-neon p-3 text-center rounded mb-5">
                <h4 class="fw-bold text-black mb-0">Administración Códigos Promocionales</h4>
            </div>

            @if (!string.IsNullOrEmpty(Model.MensajeExito))
            {
                <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    @Model.MensajeExito
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.MensajeError))
            {
                <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    @Model.MensajeError
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Botones Dashboard y Nuevo Código -->
            <div class="d-flex justify-content-end mb-2">
                <a href="/administrativo/Dashboard" class="btn btn-dashboard me-2">
                    <i class="bi bi-house-door me-2"></i> Dashboard
                </a>
            </div>
            <div class="d-flex justify-content-end mb-4">
                <button type="button" class="btn btn-success rounded px-4 py-2" data-bs-toggle="modal" data-bs-target="#newCodeModal">
                    <i class="bi bi-plus-circle me-2"></i>Nuevo Código
                </button>
            </div>

            <!-- Modal para Nuevo Código Promocional -->
            <div class="modal fade" id="newCodeModal" tabindex="-1" aria-labelledby="newCodeModalLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content bg-dark text-white rounded">
                        <div class="modal-header bg-neon">
                            <h5 class="modal-title text-black" id="newCodeModalLabel">Nuevo Código Promocional</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <form id="newCodeForm" method="post">
                                @Html.AntiForgeryToken()
                                <div class="mb-3">
                                    <label for="codigo" class="form-label">Código</label>
                                    <input type="text" class="form-control bg-dark text-white border-secondary rounded" id="codigo" name="codigo" required />
                                </div>
                                <div class="mb-3">
                                    <label for="descuento" class="form-label">Descuento (₡)</label>
                                    <input type="number" step="0.01" min="0.01" class="form-control bg-dark text-white border-secondary rounded" id="descuento" name="descuento" required />
                                </div>
                                <div class="mb-3">
                                    <label for="fechaExpiracion" class="form-label">Fecha de Expiración</label>
                                    <input type="date" class="form-control bg-dark text-white border-secondary rounded" id="fechaExpiracion" name="fechaExpiracion" required />
                                </div>
                                <div class="mb-3">
                                    <label for="estado" class="form-label">Estado</label>
                                    <select class="form-select bg-dark text-white border-secondary rounded" id="estado" name="estado" required>
                                        <option value="activo">Activo</option>
                                        <option value="expirado">Expirado</option>
                                    </select>
                                </div>
                                <button type="submit" class="btn btn-success w-100 rounded">Crear Código</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Grid de Códigos Promocionales -->
            <div class="row g-4">
                @foreach (var codigo in Model.CodigosPromo)
                {
                    <div class="col-md-4">
                        <div class="card text-white p-3 rounded shadow-sm">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title text-neon mb-2">@codigo.PorcentajeDescuento% de Descuento</h5>
                                <p class="card-text text-muted mb-1"><strong>Válido hasta:</strong> @codigo.Validez</p>
                                @if (!string.IsNullOrEmpty(codigo.Descripcion))
                                {
                                    <p class="card-text text-muted mb-1"><strong>Descripción:</strong> @codigo.Descripcion</p>
                                }
                                <p class="card-text text-neon fw-bold mb-3"><strong>Monto:</strong> ₡@codigo.Monto.ToString("N0")</p>

                                <form class="update-code-form mb-2" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@codigo.Id" />
                                    <div class="input-group">
                                        <input type="text" name="codigo" value="@codigo.Codigo" class="form-control bg-dark text-white border-secondary rounded-start" />
                                        <button type="submit" class="btn btn-primary rounded-end">
                                            <i class="bi bi-pencil me-1"></i>Actualizar
                                        </button>
                                    </div>
                                </form>

                                <form class="delete-code-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@codigo.Id" />
                                    <button type="submit" class="btn btn-danger w-100 rounded">
                                        <i class="bi bi-trash me-1"></i>Eliminar
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (Model.CodigosPromo.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-ticket-perforated-fill text-muted" style="font-size: 4rem;"></i>
                    <h4 class="text-muted mt-3">No hay códigos promocionales</h4>
                    <p class="text-muted">Crea un nuevo código promocional para comenzar.</p>
                </div>
            }
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function () {
            // Crear código promocional
            $('#newCodeForm').on('submit', function (e) {
                e.preventDefault();
                $.ajax({
                    url: '/Administrativo/AdminCodigosPromo?handler=CrearCodigo',
                    method: 'POST',
                    data: $(this).serialize(),
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (response) {
                        if (response.success) {
                            $('#newCodeModal').modal('hide');
                            $('#newCodeForm')[0].reset();
                            window.location.reload();
                        } else {
                            alert('Error: ' + response.message);
                        }
                    },
                    error: function (xhr, status, error) {
                        alert('Ocurrió un error al crear el código promocional: ' + (xhr.responseJSON?.message || error));
                    }
                });
            });

            // Actualizar código promocional
            $('.update-code-form').on('submit', function (e) {
                e.preventDefault();
                $.ajax({
                    url: '/Administrativo/AdminCodigosPromo?handler=ActualizarCodigo',
                    method: 'POST',
                    data: $(this).serialize(),
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (response) {
                        if (response.success) {
                            window.location.reload();
                        } else {
                            alert('Error: ' + response.message);
                        }
                    },
                    error: function (xhr, status, error) {
                        alert('Ocurrió un error al actualizar el código promocional: ' + (xhr.responseJSON?.message || error));
                    }
                });
            });

            // Eliminar código promocional
            $('.delete-code-form').on('submit', function (e) {
                e.preventDefault();
                if (!confirm('¿Está seguro de que desea eliminar este código promocional?')) {
                    return;
                }
                $.ajax({
                    url: '/Administrativo/AdminCodigosPromo?handler=EliminarCodigo',
                    method: 'POST',
                    data: $(this).serialize(),
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (response) {
                        if (response.success) {
                            window.location.reload();
                        } else {
                            alert('Error: ' + response.message);
                        }
                    },
                    error: function (xhr, status, error) {
                        alert('Ocurrió un error al eliminar el código promocional: ' + (xhr.responseJSON?.message || error));
                    }
                });
            });
        });
    </script>
</body>
</html>
@page
@model ticketicos.Pages.administrativo.AdminSoporteModel
@{
    ViewData["Title"] = "Tickicos - Soporte Administrativo";
}

<style>
    .main-panel {
        width: 1100px;
        height: 650px;
        margin: 30px auto;
        background-color: #505050;
        border-radius: 20px;
    }

    .title {
        width: 100%;
        height: 40px;
        background-color: rgb(193, 255, 0);
        color: black;
        font-size: 16px;
        font-weight: bold;
        text-align: center;
        line-height: 40px;
        border-top-left-radius: 20px;
        border-top-right-radius: 20px;
    }

    .content-panel {
        padding: 20px;
        height: 610px;
        text-align: center;
    }

    .chat-section {
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .chat-title {
        color: rgb(193, 255, 0);
        font-size: 18px;
        margin-bottom: 15px;
    }

    .chat-instruction {
        color: white;
        font-size: 16px;
    }

    .chat-link {
        color: rgb(193, 255, 0);
        text-decoration: underline;
    }
</style>

<div class="main-panel">
    <div class="title">Soporte Administrativo</div>
    <div class="content-panel">
        <div class="chat-section">
            <div class="chat-title">Panel de Soporte</div>
            <p class="chat-instruction">Responde en: <a href="https://wa.me/50686333240" target="_blank" class="chat-link">WhatsApp</a></p>
        </div>
    </div>
</div>
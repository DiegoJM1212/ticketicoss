@page "/administrativo/AdminPreventa"
@model ticketicos.Pages.Admin.AdminPreventaModel
@using ticketicos.Pages.Admin
@{
    ViewData["Title"] = "Administración de Preventas";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TICKETICOS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        .bg-black {
            background-color: #000000 !important;
        }

        .bg-neon {
            background-color: #C1FF00 !important;
        }

        .text-neon {
            color: #C1FF00 !important;
        }

        .card {
            background-color: #2c2c2c !important;
            border: none !important;
            border-radius: 10px !important;
            transition: transform 0.2s;
        }

            .card:hover {
                transform: translateY(-5px);
            }

        .btn-home {
            position: absolute;
            right: 1rem;
            top: 50%;
            transform: translateY(-50%);
            background-color: #666666;
            color: #ffffff;
            padding: 0.25rem 0.75rem;
            text-decoration: none;
            font-size: 0.875rem;
            border-radius: 0.25rem;
        }

        .toggle-checkbox {
            opacity: 0;
            width: 0;
            height: 0;
        }

            .toggle-checkbox:checked + .toggle-label {
                background-color: #C1FF00;
            }

                .toggle-checkbox:checked + .toggle-label::after {
                    transform: translateX(100%);
                }

        .toggle-label {
            display: block;
            width: 40px;
            height: 20px;
            background-color: #666666;
            border-radius: 20px;
            position: relative;
            cursor: pointer;
            transition: background-color 0.2s;
        }

            .toggle-label::after {
                content: '';
                position: absolute;
                top: 2px;
                left: 2px;
                width: 16px;
                height: 16px;
                background-color: #ffffff;
                border-radius: 50%;
                transition: transform 0.2s;
            }

        input[type="date"], input[type="number"] {
            background-color: #1a1a1a !important;
            border: 1px solid #444 !important;
            color: #fff !important;
            font-size: 0.9rem; /* Tamaño de fuente ajustado */
        }
        /* Ajustar tamaño de los campos de precio y entradas */
        .input-size {
            width: 100px !important; /* Aumentado de w-25 para mejor visibilidad */
            padding: 0.5rem !important; /* Más espacio interno */
        }

        .alert {
            border-radius: 5px !important;
        }
    </style>
</head>
<body>
    <div class="container-fluid bg-black min-vh-100 py-5">
        <!-- Logo -->
        <div class="d-flex justify-content-center mb-4">
            <div class="bg-neon d-flex align-items-center justify-content-center rounded" style="width: 80px; height: 80px;">
                <span class="fw-bold text-black">TICKETICOS</span>
            </div>
        </div>

        <!-- Panel Principal -->
        <div class="container">
            <!-- Título Principal -->
            <div class="bg-neon p-3 text-center rounded mb-5 position-relative">
                <h4 class="fw-bold text-black mb-0">Administración Preventas</h4>
                <a href="/administrativo/Dashboard" class="btn-home">
                    <i class="bi bi-house-door me-2"></i> Dashboard
                </a>
            </div>

            <!-- Agregar el token antifalsificación -->
            @Html.AntiForgeryToken()

            <div id="alertContainer"></div>

            @if (!string.IsNullOrEmpty(Model.MensajeExito))
            {
                <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    @Model.MensajeExito
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.MensajeError))
            {
                <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    @Model.MensajeError
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Subtítulo y Botón Actualizar -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="text-white">Configura el acceso anticipado a eventos</h2>
                <button type="button" class="btn btn-success rounded px-4 py-2" onclick="window.location.reload()">
                    <i class="bi bi-arrow-repeat me-2"></i> Actualizar
                </button>
            </div>

            @if (Model.Eventos == null || Model.Eventos.Count == 0)
            {
                <div class="card text-center p-5">
                    <i class="bi bi-ticket-perforated-fill text-muted" style="font-size: 4rem;"></i>
                    <h4 class="text-white mt-3">No hay eventos disponibles</h4>
                    <p class="text-muted">Agrega eventos desde el panel de administración de eventos.</p>
                </div>
            }
            else
            {
                <!-- Grid de Eventos -->
                <div class="row g-4">
                    @foreach (var evento in Model.Eventos)
                    {
                        <div class="col-md-4">
                            <div class="card text-white p-3 rounded shadow-sm">
                                <!-- Imagen del Evento -->
                                <div class="position-relative">
                                    <img src="@evento.ImagenUrl" alt="@evento.Nombre" class="w-100 rounded-top" style="height: 180px; object-fit: cover;" />
                                    @if (evento.EnPreventa)
                                    {
                                        <span class="position-absolute top-0 end-0 bg-neon text-black px-2 py-1 text-xs font-bold rounded-bottom-left">
                                            EN PREVENTA
                                        </span>
                                    }
                                </div>

                                <!-- Información del Evento -->
                                <div class="card-body">
                                    <h5 class="card-title text-neon mb-2">@evento.Nombre</h5>
                                    <p class="card-text text-muted mb-1"><i class="bi bi-calendar me-2"></i>@evento.Fecha.ToString("dd/MM/yyyy")</p>
                                    <p class="card-text text-muted mb-1"><i class="bi bi-clock me-2"></i>@evento.Hora</p>
                                    <p class="card-text text-muted mb-3"><i class="bi bi-geo-alt me-2"></i>@evento.Lugar</p>

                                    <!-- Estado de Preventa -->
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <span class="text-white">Preventa:</span>
                                        <div class="toggle-preventa-container">
                                            <input type="checkbox" id="toggle-@evento.Id" class="toggle-checkbox toggle-preventa"
                                                   data-id="@evento.Id" @(evento.EnPreventa ? "checked" : "") />
                                            <label for="toggle-@evento.Id" class="toggle-label"></label>
                                        </div>
                                    </div>

                                    <!-- Límite de Boletos -->
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <span class="text-white">Máx. boletos:</span>
                                        <form class="update-limite-form" data-id="@evento.Id">
                                            <input type="hidden" name="id" value="@evento.Id" />
                                            <input type="number" name="limite" value="@evento.CantidadBoletos" min="1" max="1000"
                                                   class="form-control input-size d-inline-block text-center" required />
                                            <button type="submit" class="btn btn-primary ms-2">
                                                <i class="bi bi-save"></i>
                                            </button>
                                        </form>
                                    </div>

                                    <!-- Precio Especial -->
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <span class="text-white">Precio especial:</span>
                                        <form class="update-precio-form" data-id="@evento.Id">
                                            <input type="hidden" name="id" value="@evento.Id" />
                                            <input type="number" name="precio" value="@evento.PrecioEspecial" min="0" step="0.01"
                                                   class="form-control input-size d-inline-block text-center" required />
                                            <button type="submit" class="btn btn-primary ms-2">
                                                <i class="bi bi-save"></i>
                                            </button>
                                        </form>
                                    </div>

                                    <!-- Fechas de Preventa -->
                                    <div class="border-top border-gray-600 pt-3">
                                        <form class="update-fechas-form" data-id="@evento.Id">
                                            <input type="hidden" name="id" value="@evento.Id" />
                                            <div class="mb-2">
                                                <label class="text-white text-sm">Inicio:</label>
                                                <input type="date" name="fechaInicio" value="@(evento.FechaInicioPreventa?.ToString("yyyy-MM-dd") ?? "")"
                                                       class="form-control" required />
                                            </div>
                                            <div class="mb-2">
                                                <label class="text-white text-sm">Fin:</label>
                                                <input type="date" name="fechaFin" value="@(evento.FechaFinPreventa?.ToString("yyyy-MM-dd") ?? "")"
                                                       class="form-control" required />
                                            </div>
                                            <button type="submit" class="btn btn-success w-100 rounded">
                                                Guardar fechas
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js" integrity="sha256-/xUj+3OJU5yExlq6GSYGSHk7tPXikynS7ogEvDej/m4=" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" integrity="sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9FhGdlKrxdiJJigb/j/68SIy3Te4Bkz" crossorigin="anonymous"></script>
    <script>
        $(document).ready(function () {
            // Verificar que jQuery esté cargado
            if (typeof jQuery === 'undefined') {
                console.error('jQuery no está cargado');
                return;
            }

            // Obtener el token antifalsificación
            function getAntiForgeryToken() {
                var token = $('input[name="__RequestVerificationToken"]').val();
                if (!token) {
                    console.error('Token antifalsificación no encontrado');
                    showAlert('danger', 'Error: Token antifalsificación no encontrado');
                }
                return token;
            }

            // Mostrar alertas
            function showAlert(type, message) {
                var alertHtml = `
                    <div class="alert alert-${type} alert-dismissible fade show mb-4" role="alert">
                        <i class="bi ${type === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill'} me-2"></i>
                        ${message}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>`;
                $('#alertContainer').html(alertHtml);
                setTimeout(() => $('.alert').alert('close'), 5000);
            }

            // Toggle Preventa
            $('.toggle-preventa').on('change', function () {
                var checkbox = $(this);
                var id = checkbox.data('id');
                var estado = checkbox.prop('checked');
                console.log('TogglePreventa:', { id, estado });

                $.ajax({
                    url: '/administrativo/AdminPreventa?handler=TogglePreventa',
                    method: 'POST',
                    data: { id: id, estado: estado },
                    headers: { 'RequestVerificationToken': getAntiForgeryToken() },
                    success: function (response) {
                        console.log('TogglePreventa success:', response);
                        showAlert(response.success ? 'success' : 'danger', response.message);
                        if (!response.success) {
                            checkbox.prop('checked', !estado);
                        }
                    },
                    error: function (xhr, status, error) {
                        var errorMessage = xhr.responseJSON?.message || 'Error en la solicitud: ' + error;
                        console.error('TogglePreventa error:', { xhr, status, error });
                        showAlert('danger', errorMessage);
                        checkbox.prop('checked', !estado);
                    }
                });
            });

            // Actualizar Límite de Boletos
            $('.update-limite-form').on('submit', function (e) {
                e.preventDefault();
                var form = $(this);
                var id = form.data('id');
                var limite = form.find('input[name="limite"]').val();
                console.log('ActualizarLimite:', { id, limite });

                // Validar que el límite sea un número válido
                if (!limite || isNaN(limite) || limite < 1) {
                    showAlert('danger', 'Por favor, ingrese un límite de boletos válido (mínimo 1).');
                    return;
                }

                $.ajax({
                    url: '/administrativo/AdminPreventa?handler=ActualizarLimite',
                    method: 'POST',
                    data: { id: id, limite: parseInt(limite) },
                    headers: { 'RequestVerificationToken': getAntiForgeryToken() },
                    success: function (response) {
                        console.log('ActualizarLimite success:', response);
                        showAlert(response.success ? 'success' : 'danger', response.message);
                    },
                    error: function (xhr, status, error) {
                        var errorMessage = xhr.responseJSON?.message || 'Error en la solicitud: ' + error;
                        console.error('ActualizarLimite error:', { xhr, status, error });
                        showAlert('danger', errorMessage);
                    }
                });
            });

            // Actualizar Precio Especial
            $('.update-precio-form').on('submit', function (e) {
                e.preventDefault();
                var form = $(this);
                var id = form.data('id');
                var precio = form.find('input[name="precio"]').val();
                console.log('ActualizarPrecio:', { id, precio });

                // Validar que el precio sea un número válido
                if (!precio || isNaN(precio) || precio < 0) {
                    showAlert('danger', 'Por favor, ingrese un precio válido (mínimo 0).');
                    return;
                }

                $.ajax({
                    url: '/administrativo/AdminPreventa?handler=ActualizarPrecio',
                    method: 'POST',
                    data: { id: id, precio: parseFloat(precio) },
                    headers: { 'RequestVerificationToken': getAntiForgeryToken() },
                    success: function (response) {
                        console.log('ActualizarPrecio success:', response);
                        showAlert(response.success ? 'success' : 'danger', response.message);
                    },
                    error: function (xhr, status, error) {
                        var errorMessage = xhr.responseJSON?.message || 'Error en la solicitud: ' + error;
                        console.error('ActualizarPrecio error:', { xhr, status, error });
                        showAlert('danger', errorMessage);
                    }
                });
            });

            // Actualizar Fechas de Preventa
            $('.update-fechas-form').on('submit', function (e) {
                e.preventDefault();
                var form = $(this);
                var id = form.data('id');
                var fechaInicio = form.find('input[name="fechaInicio"]').val();
                var fechaFin = form.find('input[name="fechaFin"]').val();
                console.log('ActualizarFechasPreventa:', { id, fechaInicio, fechaFin });

                // Validar que las fechas no estén vacías
                if (!fechaInicio || !fechaFin) {
                    showAlert('danger', 'Por favor, ingrese fechas de inicio y fin válidas.');
                    return;
                }

                $.ajax({
                    url: '/administrativo/AdminPreventa?handler=ActualizarFechasPreventa',
                    method: 'POST',
                    data: { id: id, fechaInicio: fechaInicio, fechaFin: fechaFin },
                    headers: { 'RequestVerificationToken': getAntiForgeryToken() },
                    success: function (response) {
                        console.log('ActualizarFechasPreventa success:', response);
                        showAlert(response.success ? 'success' : 'danger', response.message);
                    },
                    error: function (xhr, status, error) {
                        var errorMessage = xhr.responseJSON?.message || 'Error en la solicitud: ' + error;
                        console.error('ActualizarFechasPreventa error:', { xhr, status, error });
                        showAlert('danger', errorMessage);
                    }
                });
            });
        });
    </script>
</body>
</html>
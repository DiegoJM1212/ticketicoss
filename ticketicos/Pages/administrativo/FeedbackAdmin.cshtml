@page
@model ticketicos.Pages.Admin.FeedbackAdminModel
@{
    ViewData["Title"] = "Gestión de Feedback";
    Layout = null;
}
<style>
    body {
        background-color: #1e1e1e;
        color: white;
    }

    .feedback-card {
        background-color: #2b2b2b;
        color: white;
        padding: 20px;
        border-radius: 10px;
        margin-top: 20px;
    }

        .feedback-card h2 {
            color: #C1FF00;
        }

    .table-dark th {
        color: #C1FF00;
    }

    .alert {
        margin-top: 20px;
    }
</style>

<div class="container mt-5">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="feedback-card">
        <h2>Feedback de Clientes</h2>
        <table class="table table-dark table-hover mt-3">
            <thead>
                <tr>
                    <th>Comentario</th>
                    <th>Fecha</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var feedback in Model.FeedbackList)
                {
                    <tr>
                        <td>@feedback.Comentario</td>
                        <td>@feedback.FechaFeedback.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <form method="post" asp-page-handler="Delete" asp-route-idFeedback="@feedback.IdFeedback" onsubmit="return confirm('¿Estás seguro de eliminar este feedback?');">
                                <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
